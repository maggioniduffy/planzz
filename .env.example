# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only: /api/cron/* and /api/google/*. Never in client code.
SUPABASE_SECRET_KEY=

# Bearer secret that protects /api/cron/*
CRON_SECRET=

# Web push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Email (Brevo)
BREVO_API_KEY=

# Google Calendar OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile (guest sign-in)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
