# Copy to .env.local and fill in. Never commit real values.

# Supabase (secret key is server-only: /api/cron/* and /api/google/* only)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Shared secret that protects /api/cron/* (server-only)
CRON_SECRET=

# Web push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Email (Brevo)
BREVO_API_KEY=

# Google Calendar OAuth (server-only)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudflare Turnstile site key (public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
